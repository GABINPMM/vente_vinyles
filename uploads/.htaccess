# ==========================================================================
# BARWETA RECORDS — Protection Maximale du Dossier /uploads/ (Pour OVH Apache)
# Interdit formellement l'exécution de tout script (PHP, CGI, Perl, Python...)
# Autorise uniquement l'affichage des fichiers images (.jpg, .jpeg, .png, .webp)
# ==========================================================================

Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pl .py .cgi .sh

<IfModule mod_php.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(?!(jpe?g|png|webp)$)[^.]+$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
